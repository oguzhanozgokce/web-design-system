{
  "name": "highwren-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oguzhanozgokce/web-design-system.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run generate && next dev --turbopack",
    "build": "npm run generate && shadcn build registry.json --output public/r && next build",
    "start": "serve out",
    "generate": "tsx scripts/generate-tokens.ts && tsx scripts/generate-brand.ts && tsx scripts/generate-icons.ts && tsx scripts/build-registry.ts",
    "registry:build": "tsx scripts/build-registry.ts && shadcn build registry.json --output public/r",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ds": "tsx scripts/check-ds.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:ds && npm run check:secrets",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "check:registry": "tsx scripts/check-registry.ts",
    "test:watch": "vitest",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "cn": "^0.5.2",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^4.0.1"
  },
  "overrides": {
    "compression": "^1.8.2",
    "minimatch@>=7 <11.0.1": "^11.0.5"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.3",
    "@material/material-color-utilities": "^0.4.0",
    "@shadcn/registry": "0.2.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.65.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
